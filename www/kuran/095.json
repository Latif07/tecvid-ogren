{"n":95,"ar":"التين","tr":"Tîn","en":"At-Tin","ayet":["وَٱلتِّينِ وَٱلزَّيۡتُونِ","وَطُورِ سِينِينَ","وَهَٰذَا ٱلۡبَلَدِ ٱلۡأَمِينِ","لَقَدۡ خَلَقۡنَا ٱلۡإِنسَٰنَ فِيٓ أَحۡسَنِ تَقۡوِيمٖ","ثُمَّ رَدَدۡنَٰهُ أَسۡفَلَ سَٰفِلِينَ","إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّـٰلِحَٰتِ فَلَهُمۡ أَجۡرٌ غَيۡرُ مَمۡنُونٖ","فَمَا يُكَذِّبُكَ بَعۡدُ بِٱلدِّينِ","أَلَيۡسَ ٱللَّهُ بِأَحۡكَمِ ٱلۡحَٰكِمِينَ"],"renk":{"1":[[2,3,"s"],[3,4,"s"],[13,14,"s"],[14,15,"s"],[22,23,"m2"]],"2":[[13,14,"m2"]],"3":[[4,5,"m2"],[9,10,"s"],[19,20,"s"],[26,27,"m2"]],"4":[[4,6,"q"],[11,13,"q"],[17,18,"s"],[22,25,"h"],[25,26,"m2"],[31,33,"mf"],[45,47,"q"],[49,50,"m2"]],"5":[[2,5,"g"],[10,12,"q"],[14,15,"m2"],[29,30,"m2"],[34,35,"m2"]],"6":[[7,8,"s"],[40,41,"s"],[41,42,"s"],[46,47,"m2"],[51,52,"m2"],[66,68,"q"],[84,85,"m2"]],"7":[[27,28,"s"],[28,29,"s"],[32,33,"m2"]],"8":[[9,10,"s"],[28,29,"s"],[33,34,"m2"],[38,39,"m2"]]}}