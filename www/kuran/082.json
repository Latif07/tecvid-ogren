{"n":82,"ar":"الإنفطار","tr":"İnfitâr","en":"Al-Infitar","ayet":["إِذَا ٱلسَّمَآءُ ٱنفَطَرَتۡ","وَإِذَا ٱلۡكَوَاكِبُ ٱنتَثَرَتۡ","وَإِذَا ٱلۡبِحَارُ فُجِّرَتۡ","وَإِذَا ٱلۡقُبُورُ بُعۡثِرَتۡ","عَلِمَتۡ نَفۡسٞ مَّا قَدَّمَتۡ وَأَخَّرَتۡ","يَـٰٓأَيُّهَا ٱلۡإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلۡكَرِيمِ","ٱلَّذِي خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ","فِيٓ أَيِّ صُورَةٖ مَّا شَآءَ رَكَّبَكَ","كَلَّا بَلۡ تُكَذِّبُونَ بِٱلدِّينِ","وَإِنَّ عَلَيۡكُمۡ لَحَٰفِظِينَ","كِرَامٗا كَٰتِبِينَ","يَعۡلَمُونَ مَا تَفۡعَلُونَ","إِنَّ ٱلۡأَبۡرَارَ لَفِي نَعِيمٖ","وَإِنَّ ٱلۡفُجَّارَ لَفِي جَحِيمٖ","يَصۡلَوۡنَهَا يَوۡمَ ٱلدِّينِ","وَمَا هُمۡ عَنۡهَا بِغَآئِبِينَ","وَمَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلدِّينِ","ثُمَّ مَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلدِّينِ","يَوۡمَ لَا تَمۡلِكُ نَفۡسٞ لِّنَفۡسٖ شَيۡـٔٗاۖ وَٱلۡأَمۡرُ يَوۡمَئِذٖ لِّلَّهِ"],"renk":{"1":[[6,7,"s"],[7,8,"s"],[13,15,"mt"],[18,19,"s"],[19,22,"h"]],"2":[[8,9,"s"],[21,22,"s"],[22,25,"h"]],"3":[[8,9,"s"]],"4":[[8,9,"s"]],"5":[[14,19,"dg"]],"6":[[3,5,"mf"],[14,15,"s"],[19,22,"h"],[22,23,"m2"],[48,49,"s"],[55,56,"m2"]],"7":[[25,26,"m2"]],"8":[[2,4,"mf"],[17,22,"dg"],[26,28,"mt"]],"9":[[27,28,"s"],[28,29,"s"],[32,33,"m2"]],"10":[[4,7,"g"],[23,24,"m2"],[28,29,"m2"]],"11":[[6,11,"h"],[11,12,"m2"],[16,17,"m2"]],"12":[[24,25,"m2"]],"13":[[2,5,"g"],[6,7,"s"],[11,13,"q"],[29,30,"m2"]],"14":[[4,7,"g"],[8,9,"s"],[30,31,"m2"]],"15":[[21,22,"s"],[22,23,"s"],[26,27,"m2"]],"16":[[23,25,"mt"],[29,30,"m2"]],"17":[[4,6,"mf"],[9,11,"q"],[14,15,"m2"],[29,30,"s"],[30,31,"s"],[34,35,"m2"]],"18":[[2,5,"g"],[8,10,"mf"],[13,15,"q"],[18,19,"m2"],[33,34,"s"],[34,35,"s"],[38,39,"m2"]],"19":[[25,30,"db"],[35,39,"h"],[43,49,"dg"],[49,50,"s"],[68,73,"db"]]}}