{"n":87,"ar":"الأعلى","tr":"A'lâ","en":"Al-A'la","ayet":["سَبِّحِ ٱسۡمَ رَبِّكَ ٱلۡأَعۡلَى","ٱلَّذِي خَلَقَ فَسَوَّىٰ","وَٱلَّذِي قَدَّرَ فَهَدَىٰ","وَٱلَّذِيٓ أَخۡرَجَ ٱلۡمَرۡعَىٰ","فَجَعَلَهُۥ غُثَآءً أَحۡوَىٰ","سَنُقۡرِئُكَ فَلَا تَنسَىٰٓ","إِلَّا مَا شَآءَ ٱللَّهُۚ إِنَّهُۥ يَعۡلَمُ ٱلۡجَهۡرَ وَمَا يَخۡفَىٰ","وَنُيَسِّرُكَ لِلۡيُسۡرَىٰ","فَذَكِّرۡ إِن نَّفَعَتِ ٱلذِّكۡرَىٰ","سَيَذَّكَّرُ مَن يَخۡشَىٰ","وَيَتَجَنَّبُهَا ٱلۡأَشۡقَى","ٱلَّذِي يَصۡلَى ٱلنَّارَ ٱلۡكُبۡرَىٰ","ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحۡيَىٰ","قَدۡ أَفۡلَحَ مَن تَزَكَّىٰ","وَذَكَرَ ٱسۡمَ رَبِّهِۦ فَصَلَّىٰ","بَلۡ تُؤۡثِرُونَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا","وَٱلۡأٓخِرَةُ خَيۡرٞ وَأَبۡقَىٰٓ","إِنَّ هَٰذَا لَفِي ٱلصُّحُفِ ٱلۡأُولَىٰ","صُحُفِ إِبۡرَٰهِيمَ وَمُوسَىٰ"],"renk":{"1":[[8,9,"s"],[22,23,"s"]],"3":[[2,3,"s"]],"4":[[2,3,"s"],[8,10,"mf"],[20,21,"s"]],"5":[[10,11,"m2"],[16,18,"mt"]],"6":[[4,6,"q"],[21,24,"h"]],"7":[[13,15,"mt"],[18,19,"s"],[19,20,"s"],[29,32,"g"],[34,35,"m2"],[45,46,"s"]],"9":[[12,17,"dg"],[24,25,"s"],[25,26,"s"]],"10":[[15,19,"dg"]],"11":[[8,11,"g"],[17,18,"s"]],"12":[[16,17,"s"],[17,18,"s"],[18,21,"g"],[25,26,"s"],[30,32,"q"]],"13":[[2,5,"g"]],"14":[[2,4,"q"],[16,20,"h"]],"15":[[9,10,"s"],[22,23,"m2"]],"16":[[17,18,"s"],[24,25,"s"],[25,26,"m2"],[29,30,"s"],[30,31,"s"]],"17":[[2,3,"s"],[19,23,"dg"],[25,27,"q"]],"18":[[2,5,"g"],[8,9,"m2"],[19,20,"s"],[20,21,"s"],[29,30,"s"]],"19":[[9,11,"q"],[13,14,"m2"]]}}