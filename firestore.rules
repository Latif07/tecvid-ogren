rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Her kullanıcı yalnızca kendi ilerlemesini okur/yazar
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Sınıflar: kodu bilen giriş yapmış kullanıcı sınıfı görebilir (katılmak ve ödevi görmek için)
    match /classes/{kod} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && resource.data.hocaUid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.hocaUid == request.auth.uid;
      allow update: if request.auth != null && resource.data.hocaUid == request.auth.uid
                    && request.resource.data.hocaUid == resource.data.hocaUid;
      allow delete: if request.auth != null && resource.data.hocaUid == request.auth.uid;
      // Öğrenci kendi kaydını yazar; hoca sınıfındaki öğrencileri görür ve çıkarabilir
      match /ogrenciler/{uid} {
        allow read: if request.auth != null && (request.auth.uid == uid
                    || get(/databases/$(database)/documents/classes/$(kod)).data.hocaUid == request.auth.uid);
        allow create, update: if request.auth != null && request.auth.uid == uid
                    && exists(/databases/$(database)/documents/classes/$(kod));
        allow delete: if request.auth != null && (request.auth.uid == uid
                    || get(/databases/$(database)/documents/classes/$(kod)).data.hocaUid == request.auth.uid);
      }
      // Ezber dinletme: öğrenci kendi kaydını gönderir (en fazla ~900 KB), hoca dinler ve değerlendirir
      match /dinletme/{id} {
        allow create: if request.auth != null && request.resource.data.ogrUid == request.auth.uid
                      && exists(/databases/$(database)/documents/classes/$(kod)/ogrenciler/$(request.auth.uid))
                      && request.resource.data.ses is string && request.resource.data.ses.size() < 900000;
        allow read: if request.auth != null && (resource.data.ogrUid == request.auth.uid
                    || get(/databases/$(database)/documents/classes/$(kod)).data.hocaUid == request.auth.uid);
        allow update: if request.auth != null && get(/databases/$(database)/documents/classes/$(kod)).data.hocaUid == request.auth.uid
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['puan', 'not']);
        allow delete: if request.auth != null && (resource.data.ogrUid == request.auth.uid
                      || get(/databases/$(database)/documents/classes/$(kod)).data.hocaUid == request.auth.uid);
      }
    }
  }
}
